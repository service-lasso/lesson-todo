{
  "sources": [
    {
      "sourceId": "openbao-lesson",
      "kind": "openbao",
      "displayName": "OpenBao lesson",
      "enabled": true,
      "priority": 10,
      "namespaces": [
        "todo/openbao"
      ],
      "address": "https://127.0.0.1:18200",
      "mount": "secret",
      "tokenEnv": "OPENBAO_TOKEN",
      "refs": {
        "todo/openbao/openbao.DEMO_VALUE": {
          "path": "secret/data/todo/demo",
          "field": "value"
        }
      }
    }
  ]
}
